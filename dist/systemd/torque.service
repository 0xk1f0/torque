[Unit]
Description=Torque (Sendspin client)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/default/torque
ExecStart=/usr/local/bin/torque -server=${TORQUE_SERVER} ${TORQUE_OPTS}
Restart=on-failure
RestartSec=5s
# The identity key must survive restarts; keep it in a root-owned dir.
User=sendspin
Group=audio

[Install]
WantedBy=multi-user.target
