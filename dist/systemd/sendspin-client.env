# spinsync configuration for the systemd service.
# Required: the encrypted server to connect to (host:port).
SENDSPIN_SERVER=192.168.1.10:8927

# Optional flags, appended to the ExecStart line. Examples:
#   SPINSYNC_OPTS="--name Kitchen --identity /etc/sendspin/identity --buffer-ms 200"
SPINSYNC_OPTS=
