# torque configuration for the systemd service.
# Required: the encrypted Sendspin server to connect to (host:port).
TORQUE_SERVER=192.168.1.10:8927

# Optional flags. The service runs ExecStart through `/bin/sh -c`, so quotes
# and multiple flags here are word-split like on a command line. Example:
#   TORQUE_OPTS="-n 'Kitchen' -d 'snd_rpi_hifiberry_dacplus' --buffer-ms 200"
TORQUE_OPTS=
